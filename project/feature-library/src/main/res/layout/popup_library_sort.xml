<?xml version="1.0" encoding="utf-8"?>
<!-- Sort popup: milky-white card with a check mark on the active sort. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/sortModified"
        style="@style/PopupRow">
        <TextView style="@style/PopupRowLabel" android:layout_marginStart="0dp" android:text="@string/library_sort_modified" />
        <ImageView
            android:id="@+id/checkModified"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/primary_blue"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortName"
        style="@style/PopupRow">
        <TextView style="@style/PopupRowLabel" android:layout_marginStart="0dp" android:text="@string/library_sort_name" />
        <ImageView
            android:id="@+id/checkName"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/primary_blue"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortCreated"
        style="@style/PopupRow">
        <TextView style="@style/PopupRowLabel" android:layout_marginStart="0dp" android:text="@string/library_sort_created" />
        <ImageView
            android:id="@+id/checkCreated"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/primary_blue"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortType"
        style="@style/PopupRow">
        <TextView style="@style/PopupRowLabel" android:layout_marginStart="0dp" android:text="@string/library_sort_type" />
        <ImageView
            android:id="@+id/checkType"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/primary_blue"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
