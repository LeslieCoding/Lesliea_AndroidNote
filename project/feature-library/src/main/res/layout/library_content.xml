<?xml version="1.0" encoding="utf-8"?>
<!-- Shared content column for the library screen (spec 28.3): top bar with
     search + "+", breadcrumb, document grid/list, empty state, selection bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnNav"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_lib_tool_button"
            android:contentDescription="@string/library_nav_content_desc"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:tint="@color/text_primary"
            android:src="@drawable/ic_nav_menu" />

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:tint="@color/text_secondary"
                android:src="@drawable/ic_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/library_search_hint"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_lib_tool_button"
            android:contentDescription="@string/library_sort_modified"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:tint="@color/text_primary"
            android:src="@drawable/ic_sort" />

        <ImageButton
            android:id="@+id/btnViewMode"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_lib_tool_button"
            android:contentDescription="@string/library_nav_all"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:tint="@color/text_primary"
            android:src="@drawable/ic_list_view" />

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_add_button"
            android:contentDescription="@string/newitem_group_create"
            android:elevation="4dp"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:tint="@color/white"
            android:src="@drawable/ic_add" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/breadcrumbScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/breadcrumb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/emptyIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.5"
                android:src="@drawable/ic_note" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/library_empty_all"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_selection_bar"
        android:elevation="2dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

        <TextView
            android:id="@+id/selectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSelectAll"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_select_all"
            android:textColor="@color/primary_blue" />

        <Button
            android:id="@+id/btnRestore"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_action_restore"
            android:textColor="@color/primary_blue"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnMove"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_action_move"
            android:textColor="@color/primary_blue" />

        <Button
            android:id="@+id/btnCopy"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_action_copy"
            android:textColor="@color/primary_blue" />

        <Button
            android:id="@+id/btnExport"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_action_export"
            android:textColor="@color/primary_blue" />

        <Button
            android:id="@+id/btnTag"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_action_tag"
            android:textColor="@color/primary_blue" />

        <Button
            android:id="@+id/btnDelete"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_action_delete"
            android:textColor="@color/destructive" />

        <Button
            android:id="@+id/btnCancelSelection"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/library_cancel"
            android:textColor="@color/text_secondary" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
