<?xml version="1.0" encoding="utf-8"?>
<!-- Top-left hamburger navigation popup: milky-white card ("奶白高级感"),
     replaces the system-gray PopupMenu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingBottom="10dp"
        android:text="@string/library_title"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/navAll"
        style="@style/PopupRow">
        <ImageView style="@style/PopupRowIcon" android:src="@drawable/ic_all_notes" />
        <TextView style="@style/PopupRowLabel" android:text="@string/library_nav_all" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navRecent"
        style="@style/PopupRow">
        <ImageView style="@style/PopupRowIcon" android:src="@drawable/ic_recent" />
        <TextView style="@style/PopupRowLabel" android:text="@string/library_nav_recent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navFavorites"
        style="@style/PopupRow">
        <ImageView style="@style/PopupRowIcon" android:src="@drawable/ic_favorite" />
        <TextView style="@style/PopupRowLabel" android:text="@string/library_nav_favorites" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navTags"
        style="@style/PopupRow">
        <ImageView style="@style/PopupRowIcon" android:src="@drawable/ic_tag" />
        <TextView style="@style/PopupRowLabel" android:text="@string/library_nav_tags" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/border" />

    <LinearLayout
        android:id="@+id/navTrash"
        style="@style/PopupRow">
        <ImageView style="@style/PopupRowIcon" android:src="@drawable/ic_trash" />
        <TextView style="@style/PopupRowLabel" android:text="@string/library_nav_trash" />
    </LinearLayout>
</LinearLayout>
