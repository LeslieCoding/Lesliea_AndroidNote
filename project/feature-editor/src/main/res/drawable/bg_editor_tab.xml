<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <corners android:radius="@dimen/editor_corner_button" />
            <solid android:color="@color/surface_primary" />
            <stroke android:width="1dp" android:color="@color/primary_blue" />
        </shape>
    </item>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <corners android:radius="@dimen/editor_corner_button" />
            <solid android:color="@color/surface_secondary" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</selector>
