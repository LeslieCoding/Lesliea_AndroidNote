<?xml version="1.0" encoding="utf-8"?>
<!-- Editor screen: one slim unified toolbar (GoodNotes-style), full-bleed ink
     surface + overlay, bottom page-thumbnail bar. The title lives in the tab
     strip; auxiliary/insert tools live in the "+" popup (popup_aux_tools.xml). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/editor_toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/surface_primary"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary"
            android:contentDescription="@string/editor_back" />

        <ImageButton
            android:id="@+id/btn_undo"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_undo"
            app:tint="@color/tool_icon_tint"
            android:contentDescription="@string/editor_undo" />

        <ImageButton
            android:id="@+id/btn_redo"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_redo"
            app:tint="@color/tool_icon_tint"
            android:contentDescription="@string/editor_redo" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="@color/border" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tool_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_tool_fountain"
                    style="@style/EditorToolButton"
                    android:src="@drawable/ic_tool_pen_fountain"
                    android:contentDescription="@string/tool_fountain_pen" />

                <ImageButton
                    android:id="@+id/btn_tool_ballpoint"
                    style="@style/EditorToolButton"
                    android:src="@drawable/ic_tool_pen_ballpoint"
                    android:contentDescription="@string/tool_ballpoint" />

                <ImageButton
                    android:id="@+id/btn_tool_pencil"
                    style="@style/EditorToolButton"
                    android:src="@drawable/ic_tool_pencil"
                    android:contentDescription="@string/tool_pencil" />

                <ImageButton
                    android:id="@+id/btn_tool_highlighter"
                    style="@style/EditorToolButton"
                    android:src="@drawable/ic_tool_highlighter"
                    android:contentDescription="@string/tool_highlighter" />

                <ImageButton
                    android:id="@+id/btn_tool_eraser"
                    style="@style/EditorToolButton"
                    android:src="@drawable/ic_tool_eraser"
                    android:contentDescription="@string/tool_eraser" />

                <ImageButton
                    android:id="@+id/btn_tool_lasso"
                    style="@style/EditorToolButton"
                    android:src="@drawable/ic_tool_lasso"
                    android:contentDescription="@string/tool_lasso" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@color/border" />

        <ImageButton
            android:id="@+id/btn_aux"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary"
            android:contentDescription="@string/aux_more_tools" />

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary"
            android:contentDescription="@string/editor_search" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"
            app:tint="@color/text_primary"
            android:contentDescription="@string/editor_more" />
    </LinearLayout>

    <!-- Ink surface: single-page InkView or continuous-scroll list, plus overlay -->
    <FrameLayout
        android:id="@+id/editor_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/thumbnail_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.leslie.colorosnote.core.render.InkView
            android:id="@+id/ink_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.leslie.colorosnote.feature.editor.ContinuousPageRecyclerView
            android:id="@+id/continuous_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:overScrollMode="never" />

        <com.leslie.colorosnote.feature.editor.EditorOverlayView
            android:id="@+id/overlay_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <TextView
            android:id="@+id/pressure_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_popup"
            android:text="@string/editor_simulated_pressure"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!-- Floating fit-page button (top-right). Shown only while zoomed in;
             tap restores the whole-page view (云记-style quick zoom-out). -->
        <ImageButton
            android:id="@+id/btn_fit_page"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:layout_gravity="top|end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_popup"
            android:src="@drawable/ic_fit_page"
            app:tint="@color/text_primary"
            android:elevation="6dp"
            android:contentDescription="@string/editor_fit_page"
            android:visibility="gone" />

        <!-- Live zoom indicator (top-center, v2.1.3): the current viewport
             scale as a percentage of the fitted whole-page view, updated on
             every viewport change. Hidden at 100% (no zoom) and in
             continuous-scroll mode. Blue+bold so it stands out. Not
             clickable (never steals pen input). -->
        <TextView
            android:id="@+id/zoom_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="@drawable/bg_popup"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_blue"
            android:elevation="6dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Floating recording control bar (milky-white card under the top bar):
         elapsed timer + pause/resume + stop. -->
    <LinearLayout
        android:id="@+id/recording_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_popup"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/recording_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="@color/recording_red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_recording_pause"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_popup_item"
            android:text="@string/recording_pause"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_recording_stop"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:layout_marginStart="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_popup_item"
            android:text="@string/recording_stop_action"
            android:textColor="@color/destructive"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- In-document search panel (milky-white card under the top bar) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_popup"
        android:elevation="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/search_bar_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/editor_search" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="@string/editor_search_hint"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text" />

            <ImageButton
                android:id="@+id/search_clear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:visibility="gone"
                android:contentDescription="@string/editor_search_clear" />

            <ImageButton
                android:id="@+id/search_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_chevron_up"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/editor_search_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/search_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="2dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/search_bar_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:overScrollMode="never"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="400dp"
            app:layout_constraintTop_toBottomOf="@id/search_bar_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Page thumbnail navigation (spec 26) -->
    <LinearLayout
        android:id="@+id/thumbnail_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/editor_thumb_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/surface_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/thumb_list"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <ImageButton
            android:id="@+id/btn_add_page"
            android:layout_width="@dimen/editor_tool_button"
            android:layout_height="@dimen/editor_tool_button"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tool_button"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary"
            android:contentDescription="@string/page_add" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
